VITE_APP_NAME=StageBuild

# Forge Console — https://forgeconsole.app/api/public/v1
# La clé projet Forge est une clé publique côté client. Ne jamais exposer de secret administrateur.
VITE_FORGE_API_URL=https://forgeconsole.app/api/public/v1
VITE_FORGE_PROJECT_KEY=your-project-key
VITE_FORGE_API_KEY=your-project-api-key

# SaaS multi-institutions
# Mettre false uniquement si la migration sql/saas_multitenant.sql n'est pas encore appliquée.
VITE_SAAS_MULTITENANT=true
VITE_DEFAULT_INSTITUTION_SLUG=institution-principale
